# HTTP
HOST=0.0.0.0
PORT=5050

# Long random string, 32+ characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min

# First admin, created only when the users table is empty
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# SQLite file
DB_PATH=./data.sqlite

# Path to adb if it is not in PATH
ADB_PATH=adb

# How often TV status is checked, ms
POLL_INTERVAL_MS=15000
